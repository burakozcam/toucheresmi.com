generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEMPORARY
  SUPER_ADMIN
  DEALER
  SCHOOL_ADMIN
  STUDENT
  PARENT
}

enum ApplicationType {
  DEALER
  SCHOOL
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum PublisherRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnswerKeyFileCategory {
  ANSWER_KEY
  LEARNING_OUTCOMES
}

model User {
  temporaryAccess TemporaryAccess?
  supportTickets SupportTicket[]
  supportUpdates SupportUpdate[]
  sessions AuthSession[]
  trustedDevices TrustedDevice[]
  twoFactorSecret String?
  twoFactorPending String?
  twoFactorPendingAt DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorCounter BigInt @default(-1)
  recoveryHashes String[] @default([])
  lastLoginAt DateTime?

  opticalTxtFiles OpticalTxtFile[]
  readerManagerId String?
  readerStudentNo String?
  readerManager User? @relation("ReaderManager", fields: [readerManagerId], references: [id], onDelete: SetNull)
  managedReaders User[] @relation("ReaderManager")
  studentResultAccess StudentResultAccess[]
  opticalResults OpticalResult[]
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  setupTokenHash String? @unique
  setupExpiresAt DateTime?
  avatar       String?
  firstName    String
  lastName     String
  phone        String?
  role         Role
  dealerId     String?
  schoolId     String?
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealer                          Dealer?                  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  school                          School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdFmts                     FmtTemplate[]            @relation("FmtCreator")
  publisherRequests               PublisherRequest[]       @relation("PublisherRequestByUser")
  reviewedPublisherRequests       PublisherRequest[]       @relation("PublisherRequestReviewedBy")
  publishedAnswerKeysCreated      PublishedAnswerKey[]     @relation("PublishedAnswerKeyCreator")
  schoolsCreated                  School[]                 @relation("SchoolCreator")
  schoolDuplicateAttemptsCreated  SchoolDuplicateAttempt[] @relation("SchoolDuplicateAttemptSubmitter")
  schoolDuplicateAttemptsReviewed SchoolDuplicateAttempt[] @relation("SchoolDuplicateAttemptReviewer")
  contactMessages                 ContactMessage[]
  auditLogs                       AuditLog[]

  @@index([dealerId])
  @@index([schoolId])
  @@index([role, active])
  @@index([readerManagerId, role, createdAt])
}

model RegistrationRequest {
  id           String             @id @default(cuid())
  email        String
  passwordHash String?
  firstName    String
  lastName     String
  phone        String
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([email, status])
  @@index([status, createdAt])
}

model Dealer {
  canCreateSchool Boolean @default(true)
  canEditSchool Boolean @default(true)
  canEvaluate Boolean @default(true)
  canDeleteResult Boolean @default(true)
  canEditResult Boolean @default(true)
  canReevaluate Boolean @default(true)
  canExport Boolean @default(true)
  restrictedRegions Boolean @default(false)
  dailyStudentLimit Int?
  regions DealerRegion[]
  usage DealerDailyUsage[]
  quotaStudents DealerQuotaStudent[]

  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  schools School[]
}

model School {
  examReportLogos ExamReportLogo[]
  studentPortals StudentPortal[]
  opticalResults OpticalResult[]
  id              String   @id @default(cuid())
  dealerId        String?
  createdByUserId String?
  name            String
  code            String?  @unique
  city            String?
  district        String?
  duplicateKey    String   @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealer            Dealer?                  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("SchoolCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  users             User[]
  exams             Exam[]
  uploads           UploadBatch[]
  duplicateAttempts SchoolDuplicateAttempt[]

  @@index([dealerId, active])
  @@index([dealerId])
  @@index([createdByUserId, active])
  @@index([name])
}

model OpticalTemplate {
  grade Int?
  publisherId String?
  sourceFormat String?
  publisher Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  shares FmtShare[]
  validation Json?
  id String @id @default(cuid())
  name String @unique
  originalFmt String
  originalBase64 String?
  layout Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  results OpticalResult[]
}

model OpticalKey {
  examReportLogos ExamReportLogo[]
  id String @id @default(cuid())
  name String @unique
  questions Json
  penalty Int @default(3)
  active Boolean @default(true)
  publicationId String? @unique
  publication PublishedAnswerKey? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  results OpticalResult[]
}

model OpticalResult {
  portalGrants StudentPortalGrant[]
  txtUses OpticalTxtUse[]
  txtFiles OpticalTxtFile[]
  id String @id @default(cuid())
  seriesId String @default(cuid())
  revision Int @default(1)
  supersedesId String? @unique
  supersedes OpticalResult? @relation("ResultRevisions", fields: [supersedesId], references: [id], onDelete: Restrict)
  nextRevision OpticalResult? @relation("ResultRevisions")
  uploadChecksum String?
  reviewedAt DateTime?
  schoolId String
  templateId String
  keyId String
  createdById String
  filename String
  snapshot Json
  studentPublished Boolean @default(false)
  studentAccess StudentResultAccess[]
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  template OpticalTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  key OpticalKey @relation(fields: [keyId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([schoolId, createdAt])
  @@unique([seriesId, revision])
}

model StudentResultAccess {
  id String @id @default(cuid())
  userId String
  resultId String
  studentNo String
  studentName String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  result OpticalResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@unique([userId, resultId, studentNo])
  @@index([userId, createdAt])
  @@index([resultId])
}

model SchoolDuplicateAttempt {
  id                String    @id @default(cuid())
  submittedByUserId String?
  matchedSchoolId   String
  submittedName     String
  submittedCity     String?
  submittedDistrict String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime  @default(now())

  submittedBy   User?  @relation("SchoolDuplicateAttemptSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  matchedSchool School @relation(fields: [matchedSchoolId], references: [id], onDelete: Restrict)
  reviewedBy    User?  @relation("SchoolDuplicateAttemptReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewedAt, createdAt])
  @@index([submittedByUserId, createdAt])
  @@index([matchedSchoolId])
}

model Application {
  id           String            @id @default(cuid())
  type         ApplicationType
  organization String
  contactName  String
  email        String
  phone        String
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model FmtTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  recordWidth Int
  createdById String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User          @relation("FmtCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fields    FmtField[]
  uploads   UploadBatch[]

  @@index([active, name])
}

model FmtField {
  id            String   @id @default(cuid())
  fmtTemplateId String
  key           String
  label         String
  startIndex    Int
  endIndex      Int
  dataType      String   @default("TEXT")
  required      Boolean  @default(false)
  createdAt     DateTime @default(now())

  fmtTemplate FmtTemplate @relation(fields: [fmtTemplateId], references: [id], onDelete: Cascade)

  @@unique([fmtTemplateId, key])
  @@index([fmtTemplateId, startIndex])
}

model UploadBatch {
  id            String       @id @default(cuid())
  schoolId      String
  fmtTemplateId String
  originalName  String
  storageKey    String
  checksum      String?
  status        UploadStatus @default(RECEIVED)
  errorMessage  String?
  uploadedAt    DateTime     @default(now())
  processedAt   DateTime?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  fmtTemplate FmtTemplate  @relation(fields: [fmtTemplateId], references: [id], onDelete: Restrict)
  records     ScanRecord[]

  @@index([schoolId, uploadedAt])
  @@index([fmtTemplateId, status])
}

model Exam {
  id           String   @id @default(cuid())
  schoolId     String
  publisherId  String?
  name         String
  examDate     DateTime
  academicYear String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  publisher Publisher?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  subjects  ExamSubject[]

  @@index([schoolId, examDate])
  @@index([publisherId])
}

model ExamSubject {
  id              String @id @default(cuid())
  examId          String
  name            String
  questionCount   Int
  wrongPerCorrect Int    @default(0)

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  answerKey AnswerKey?

  @@unique([examId, name])
}

model AnswerKey {
  id            String   @id @default(cuid())
  examSubjectId String   @unique
  answers       Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
}

model Publisher {
  storeBrands StoreBrand[]
  description String?
  email String?
  phone String?
  opticalTemplates OpticalTemplate[]
  logo PublisherLogo?
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answerKeys        PublishedAnswerKey[]
  publisherRequests PublisherRequest[]
  exams             Exam[]
  scheduleEntries   ExamScheduleEntry[]

  @@index([active, name])
}

model PublisherRequest {
  id                String                 @id @default(cuid())
  publisherName     String
  normalizedName    String
  description       String?
  publisherId       String?
  requestedByUserId String
  status            PublisherRequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  requestedBy User       @relation("PublisherRequestByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?      @relation("PublisherRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([normalizedName, status])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([publisherId])
}

model PublishedAnswerKey {
  coverImage String? @db.Text
  examDate DateTime? @db.Date
  id              String   @id @default(cuid())
  publisherId     String
  grade           Int
  examName        String
  published       Boolean  @default(true)
  showInEvaluation Boolean @default(false)
  opticalKey OpticalKey?
  publishedAt     DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  publisher Publisher       @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  createdBy User            @relation("PublishedAnswerKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  files     AnswerKeyFile[]
  announcements Announcement[]
  scheduleEntries ExamScheduleEntry[]

  @@index([published, createdAt])
  @@index([published, publishedAt])
  @@index([publisherId, grade])
}

model ExamScheduleEntry {
  id          String @id @default(cuid())
  publisherId String
  level       String
  sequence    Int
  examDate    DateTime @db.Date
  scope       String @db.Text
  answerKeyId String?
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  importId String?
  importBaseline DateTime?
  series String?
  sourcePublisher String?
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  answerKey PublishedAnswerKey? @relation(fields: [answerKeyId], references: [id], onDelete: SetNull)
  @@unique([publisherId, level, sequence, examDate])
  @@index([published, level, examDate])
  @@index([answerKeyId])
  @@index([importId])
}

model AnswerKeyFile {
  generated Boolean @default(false)
  id               String                @id @default(cuid())
  answerKeyId      String
  category         AnswerKeyFileCategory
  originalFileName String
  storedFileName   String
  mimeType         String
  size             Int
  storagePath      String
  createdAt        DateTime              @default(now())

  publishedAnswerKey PublishedAnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)

  @@index([answerKeyId, category])
}

model ScanRecord {
  id            String   @id @default(cuid())
  uploadBatchId String
  studentNumber String
  studentName   String?
  classroom     String?
  answers       Json
  rawLineNumber Int?
  createdAt     DateTime @default(now())

  uploadBatch UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)

  @@unique([uploadBatchId, studentNumber])
  @@index([studentNumber])
  @@index([classroom])
}

model ContactMessage {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String    @db.Text
  userId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  action      String
  targetType  String?
  targetId    String?
  summary     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model ScheduleImport {
  id String @id @default(cuid())
  actorId String
  createdAt DateTime @default(now())
  total Int
  saved Int @default(0)
  invalid Int @default(0)
  duplicates Int @default(0)
  status String @default("processing")
}
model PublisherAlias {
  id String @id @default(cuid())
  source String @unique
  publisherId String
  series String?
  updatedAt DateTime @updatedAt
}

model FmtShare {
  id String @id @default(cuid())
  startsAt DateTime?
  tokenHash String @unique
  templateId String?
  fileRefs Json?
  createdById String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  template OpticalTemplate? @relation(fields:[templateId],references:[id],onDelete:Cascade)
  @@index([createdById,createdAt])
  @@index([expiresAt])
  usedAt DateTime?
  category String @default("FMT")
  targetId String?
  name String?
  tokenEncrypted String?
  views Int @default(0)
  downloads Int @default(0)
  lastAccessAt DateTime?

}

model Announcement {
  id String @id @default(cuid())
  category String
  title String
  summary String
  content String @db.Text
  startsAt DateTime
  endsAt DateTime?
  state String @default("ACTIVE")
  audience String @default("ALL")
  priority Int @default(0)
  pinned Boolean @default(false)
  section String?
  source String @default("MANUAL")
  sourceEvent String? @unique
  publicationId String?
  publication PublishedAnswerKey? @relation(fields:[publicationId],references:[id],onDelete:SetNull)
  releaseDate DateTime?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  targets AnnouncementTarget[]
  reads AnnouncementRead[]
  @@index([state, startsAt, endsAt])
  @@index([category, state, startsAt])
  @@index([publicationId])
}

model AnnouncementTarget {
  announcementId String
  targetId String
  announcement Announcement @relation(fields:[announcementId],references:[id],onDelete:Cascade)
  @@id([announcementId,targetId])
  @@index([targetId,announcementId])
}

model AnnouncementRead {
  announcementId String
  userId String
  readAt DateTime @default(now())
  announcement Announcement @relation(fields:[announcementId],references:[id],onDelete:Cascade)
  @@id([announcementId,userId])
}

model AnnouncementAutomation {
  kind String @id
  enabled Boolean @default(false)
  audience String @default("ALL")
  targetIds String[] @default([])
  updatedAt DateTime @updatedAt
}

model SystemEvent {
  id String @id @default(cuid())
  kind String
  severity String
  route String
  status Int
  ip String?
  actorId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([kind, createdAt])
}

model IpRestriction {
  id String @id @default(cuid())
  ip String
  reason String
  actorId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  @@index([ip, expiresAt])
}

model BlogPost {
  id String @id @default(cuid())
  title String
  summary String
  content String
  image String?
  published Boolean @default(false)
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, createdAt])
}

model ManagedFolder {
  id String @id @default(cuid())
  name String
  parentId String?
  parent ManagedFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ManagedFolder[] @relation("FolderTree")
  files ManagedFile[]
  createdAt DateTime @default(now())
  @@index([parentId])
}

model ManagedFile {
  id String @id @default(cuid())
  name String
  storedName String @unique
  size Int
  folderId String?
  folder ManagedFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  actorId String
  createdAt DateTime @default(now())
  shares ManagedFileShare[]
  @@index([folderId, createdAt])
}

model ManagedFileShare {
  id String @id @default(cuid())
  fileId String
  file ManagedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  startsAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  actorId String
  createdAt DateTime @default(now())
  @@index([fileId, createdAt])
}

model AnalyticsMetric {
  day String
  page String
  hour Int
  views Int @default(0)
  @@id([day, page, hour])
  @@index([day])
}

model AnalyticsVisitor {
  day String
  visitor String
  @@id([day, visitor])
}

model PublisherLogo {
  publisherId String @id
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  storedName String @unique
  checksum String
  width Int
  height Int
  updatedAt DateTime @updatedAt
}

// Private, encrypted TXT archive. Upload and evaluation are independent operations.
model OpticalTxtFile {
  uses OpticalTxtUse[]
  id String @id @default(cuid())
  name String
  storedName String @unique
  size Int
  checksum String
  createdById String
  createdBy User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  evaluatedAt DateTime?
  resultId String?
  result OpticalResult? @relation(fields:[resultId],references:[id],onDelete:SetNull)
  deletedAt DateTime?
  @@index([createdById,deletedAt,createdAt])
  @@index([resultId])
}

model OpticalTxtUse {
  fileId String
  resultId String
  createdAt DateTime @default(now())
  file OpticalTxtFile @relation(fields:[fileId],references:[id],onDelete:Cascade)
  result OpticalResult @relation(fields:[resultId],references:[id],onDelete:Cascade)
  @@id([fileId,resultId])
  @@index([resultId])
}

model ScoreProfile {
  id String @id @default(cuid())
  name String
  publisher String
  grade Int
  base Float
  weights Json
  multipleMark String @default("wrong")
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@index([publisher,grade,active])
}


model AuthSession {
  id String @id @default(uuid())
  userId String
  credentialVersion String
  role Role
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  mfaVerifiedAt DateTime?
  actorAdminId String?
  trustedDeviceId String?
  parentSessionId String?
  label String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, revokedAt, expiresAt])
  @@index([parentSessionId])
}
model TrustedDevice {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  credentialVersion String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  label String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, revokedAt])
}
model DealerRegion {
  id String @id @default(cuid())
  dealerId String
  publisherId String?
  city String?
  district String?
  dealer Dealer @relation(fields:[dealerId], references:[id], onDelete:Cascade)
  @@index([dealerId, publisherId])
}
model DealerDailyUsage {
  id String @id @default(cuid())
  dealerId String
  day String
  students Int @default(0)
  evaluations Int @default(0)
  dealer Dealer @relation(fields:[dealerId], references:[id], onDelete:Restrict)
  @@unique([dealerId, day])
}
model DealerQuotaStudent {
  id String @id @default(cuid())
  dealerId String
  day String
  keyId String
  schoolId String
  studentHash String
  dealer Dealer @relation(fields:[dealerId], references:[id], onDelete:Restrict)
  @@unique([dealerId, day, keyId, schoolId, studentHash])
}
model DealerActivity {
  id String @id @default(cuid())
  dealerId String?
  actorUserId String
  actorAdminId String?
  schoolId String?
  keyId String?
  publisherId String?
  city String?
  district String?
  action String
  success Boolean
  studentCount Int @default(0)
  resultId String?
  createdAt DateTime @default(now())
  @@index([dealerId, createdAt])
  @@index([schoolId, createdAt])
  @@index([publisherId, createdAt])
  @@index([action, createdAt])
}
model SchoolLocationRequest {
  id String @id @default(cuid())
  schoolId String
  dealerId String
  actorUserId String
  city String
  district String
  previousCity String?
  previousDistrict String?
  status String @default("PENDING")
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}
model SecurityRateBucket {
  key String @id
  count Int @default(1)
  resetAt DateTime
  @@index([resetAt])
}

model PublicResultCode {
  codeHash String @id
  schoolId String
  keyId String
  createdAt DateTime @default(now())
  @@index([schoolId,keyId])
}

// v1.3.5 catalog is closed until an administrator explicitly opens it.
model StoreSettings {
  id String @id @default("main")
  open Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model StoreCategory {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  parentId String?
  parent StoreCategory? @relation("StoreCategoryTree", fields:[parentId], references:[id], onDelete:Restrict)
  children StoreCategory[] @relation("StoreCategoryTree")
  products StoreProduct[]
  updatedAt DateTime @updatedAt
}
model StoreBrand {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  logo String?
  active Boolean @default(true)
  publisherId String?
  publisher Publisher? @relation(fields:[publisherId], references:[id], onDelete:Restrict)
  products StoreProduct[]
  updatedAt DateTime @updatedAt
}
model StoreProduct {
  id String @id @default(cuid())
  barcode String? @unique
  name String
  description String @default("")
  price Decimal @db.Decimal(12,2)
  discount Int @default(0)
  stock Int @default(0)
  categoryId String
  brandId String
  grade Int?
  lesson String?
  images String[] @default([])
  active Boolean @default(false)
  category StoreCategory @relation(fields:[categoryId], references:[id], onDelete:Restrict)
  brand StoreBrand @relation(fields:[brandId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active,categoryId,brandId])
}
model StudentPortal {
  id String @id @default(cuid())
  schoolId String
  academicYear String
  studentNo String
  codeHash String @unique
  version Int @default(1)
  school School @relation(fields:[schoolId], references:[id], onDelete:Restrict)
  grants StudentPortalGrant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,academicYear,studentNo])
}
model StudentPortalGrant {
  id String @id @default(cuid())
  portalId String
  resultId String
  studentId String
  identityKey String
  portal StudentPortal @relation(fields:[portalId], references:[id], onDelete:Cascade)
  result OpticalResult @relation(fields:[resultId], references:[id], onDelete:Restrict)
  @@unique([portalId,resultId])
}

// Submitted public searches only. No account, address, fingerprint or session identifiers.
model SearchHistory {
  id String @id @default(cuid())
  term String @db.VarChar(120)
  day String @db.VarChar(10)
  count Int @default(1)
  createdAt DateTime @default(now())
  lastSearchedAt DateTime @default(now())
  @@unique([day, term])
  @@index([lastSearchedAt])
}

// Future question archive. Private storage keys, never public document URLs.
// Existing exams/results remain immutable; mappings use their historical fingerprint.
model QuestionArchive {
  id String @id @default(cuid())
  examId String
  publisherId String
  examVersion String
  grade Int
  lesson String
  session String
  booklet String
  originalNumber Int
  canonicalNumber Int
  correctAnswer String
  storageKey String
  mediaType String
  contentSha256 String
  rightsStatus String @default("PENDING")
  rightsReference String?
  rightsExpiresAt DateTime?
  createdAt DateTime @default(now())
  @@unique([examId, examVersion, lesson, session, booklet, originalNumber], map: "QuestionArchive_source_question_key")
  @@index([examId, examVersion, lesson, canonicalNumber])
}

// Optional report branding belongs to an institution's exam, never the global key.
model ExamReportLogo {
  id String @id @default(cuid())
  schoolId String
  keyId String
  enabled Boolean @default(true)
  image String @db.Text
  updatedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key OpticalKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  @@unique([schoolId, keyId])
  @@index([keyId])
}

// Immutable structures are copied into OpticalKey.questions; old exams never follow later edits.
model OpticalExamTemplate {
  id String @id @default(cuid())
  name String
  structure Json
  createdById String
  createdAt DateTime @default(now())
  @@index([createdById, createdAt])
}


enum SupportStatus {
  SENT
  RECEIVED
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  userId String
  category String
  subject String
  description String @db.Text
  status SupportStatus @default(SENT)
  version Int @default(1)
  ownerReadVersion Int @default(1)
  adminReadVersion Int @default(0)
  imageName String?
  technical Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  updates SupportUpdate[]
  @@index([userId,updatedAt])
  @@index([category,status,updatedAt])
}

model SupportUpdate {
  id String @id @default(cuid())
  ticketId String
  authorId String
  version Int
  body String @db.Text
  status SupportStatus?
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  @@unique([ticketId,version])
}

model TemporaryAccess {
  id String @id @default(cuid())
  userId String @unique
  note String
  scopes String[]
  codeHash String @unique
  linkHash String? @unique
  linkUsedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt,revokedAt])
}
