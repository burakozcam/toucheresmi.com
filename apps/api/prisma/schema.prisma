generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DEALER
  SCHOOL_ADMIN
  STUDENT
  PARENT
}

enum ApplicationType {
  DEALER
  SCHOOL
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum PublisherRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnswerKeyFileCategory {
  ANSWER_KEY
  LEARNING_OUTCOMES
}

model User {
  readerManagerId String?
  readerStudentNo String?
  readerManager User? @relation("ReaderManager", fields: [readerManagerId], references: [id], onDelete: SetNull)
  managedReaders User[] @relation("ReaderManager")
  studentResultAccess StudentResultAccess[]
  opticalResults OpticalResult[]
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  setupTokenHash String? @unique
  setupExpiresAt DateTime?
  firstName    String
  lastName     String
  phone        String?
  role         Role
  dealerId     String?
  schoolId     String?
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealer                          Dealer?                  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  school                          School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdFmts                     FmtTemplate[]            @relation("FmtCreator")
  publisherRequests               PublisherRequest[]       @relation("PublisherRequestByUser")
  reviewedPublisherRequests       PublisherRequest[]       @relation("PublisherRequestReviewedBy")
  publishedAnswerKeysCreated      PublishedAnswerKey[]     @relation("PublishedAnswerKeyCreator")
  schoolsCreated                  School[]                 @relation("SchoolCreator")
  schoolDuplicateAttemptsCreated  SchoolDuplicateAttempt[] @relation("SchoolDuplicateAttemptSubmitter")
  schoolDuplicateAttemptsReviewed SchoolDuplicateAttempt[] @relation("SchoolDuplicateAttemptReviewer")
  contactMessages                 ContactMessage[]
  auditLogs                       AuditLog[]

  @@index([dealerId])
  @@index([schoolId])
  @@index([role, active])
  @@index([readerManagerId, role, createdAt])
}

model RegistrationRequest {
  id           String             @id @default(cuid())
  email        String
  passwordHash String?
  firstName    String
  lastName     String
  phone        String
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([email, status])
  @@index([status, createdAt])
}

model Dealer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  schools School[]
}

model School {
  opticalResults OpticalResult[]
  id              String   @id @default(cuid())
  dealerId        String?
  createdByUserId String?
  name            String
  code            String?  @unique
  city            String?
  district        String?
  duplicateKey    String   @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealer            Dealer?                  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("SchoolCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  users             User[]
  exams             Exam[]
  uploads           UploadBatch[]
  duplicateAttempts SchoolDuplicateAttempt[]

  @@index([dealerId, active])
  @@index([dealerId])
  @@index([createdByUserId, active])
  @@index([name])
}

model OpticalTemplate {
  shares FmtShare[]
  validation Json?
  id String @id @default(cuid())
  name String @unique
  originalFmt String
  originalBase64 String?
  layout Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  results OpticalResult[]
}

model OpticalKey {
  id String @id @default(cuid())
  name String @unique
  questions Json
  penalty Int @default(3)
  active Boolean @default(true)
  publicationId String? @unique
  publication PublishedAnswerKey? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  results OpticalResult[]
}

model OpticalResult {
  id String @id @default(cuid())
  seriesId String @default(cuid())
  revision Int @default(1)
  supersedesId String? @unique
  supersedes OpticalResult? @relation("ResultRevisions", fields: [supersedesId], references: [id], onDelete: Restrict)
  nextRevision OpticalResult? @relation("ResultRevisions")
  uploadChecksum String?
  reviewedAt DateTime?
  schoolId String
  templateId String
  keyId String
  createdById String
  filename String
  snapshot Json
  studentPublished Boolean @default(false)
  studentAccess StudentResultAccess[]
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  template OpticalTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  key OpticalKey @relation(fields: [keyId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([schoolId, createdAt])
  @@unique([seriesId, revision])
}

model StudentResultAccess {
  id String @id @default(cuid())
  userId String
  resultId String
  studentNo String
  studentName String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  result OpticalResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@unique([userId, resultId, studentNo])
  @@index([userId, createdAt])
  @@index([resultId])
}

model SchoolDuplicateAttempt {
  id                String    @id @default(cuid())
  submittedByUserId String?
  matchedSchoolId   String
  submittedName     String
  submittedCity     String?
  submittedDistrict String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime  @default(now())

  submittedBy   User?  @relation("SchoolDuplicateAttemptSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  matchedSchool School @relation(fields: [matchedSchoolId], references: [id], onDelete: Restrict)
  reviewedBy    User?  @relation("SchoolDuplicateAttemptReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewedAt, createdAt])
  @@index([submittedByUserId, createdAt])
  @@index([matchedSchoolId])
}

model Application {
  id           String            @id @default(cuid())
  type         ApplicationType
  organization String
  contactName  String
  email        String
  phone        String
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model FmtTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  recordWidth Int
  createdById String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User          @relation("FmtCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fields    FmtField[]
  uploads   UploadBatch[]

  @@index([active, name])
}

model FmtField {
  id            String   @id @default(cuid())
  fmtTemplateId String
  key           String
  label         String
  startIndex    Int
  endIndex      Int
  dataType      String   @default("TEXT")
  required      Boolean  @default(false)
  createdAt     DateTime @default(now())

  fmtTemplate FmtTemplate @relation(fields: [fmtTemplateId], references: [id], onDelete: Cascade)

  @@unique([fmtTemplateId, key])
  @@index([fmtTemplateId, startIndex])
}

model UploadBatch {
  id            String       @id @default(cuid())
  schoolId      String
  fmtTemplateId String
  originalName  String
  storageKey    String
  checksum      String?
  status        UploadStatus @default(RECEIVED)
  errorMessage  String?
  uploadedAt    DateTime     @default(now())
  processedAt   DateTime?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  fmtTemplate FmtTemplate  @relation(fields: [fmtTemplateId], references: [id], onDelete: Restrict)
  records     ScanRecord[]

  @@index([schoolId, uploadedAt])
  @@index([fmtTemplateId, status])
}

model Exam {
  id           String   @id @default(cuid())
  schoolId     String
  publisherId  String?
  name         String
  examDate     DateTime
  academicYear String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  publisher Publisher?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  subjects  ExamSubject[]

  @@index([schoolId, examDate])
  @@index([publisherId])
}

model ExamSubject {
  id              String @id @default(cuid())
  examId          String
  name            String
  questionCount   Int
  wrongPerCorrect Int    @default(0)

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  answerKey AnswerKey?

  @@unique([examId, name])
}

model AnswerKey {
  id            String   @id @default(cuid())
  examSubjectId String   @unique
  answers       Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
}

model Publisher {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answerKeys        PublishedAnswerKey[]
  publisherRequests PublisherRequest[]
  exams             Exam[]
  scheduleEntries   ExamScheduleEntry[]

  @@index([active, name])
}

model PublisherRequest {
  id                String                 @id @default(cuid())
  publisherName     String
  normalizedName    String
  description       String?
  publisherId       String?
  requestedByUserId String
  status            PublisherRequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  requestedBy User       @relation("PublisherRequestByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?      @relation("PublisherRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([normalizedName, status])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([publisherId])
}

model PublishedAnswerKey {
  id              String   @id @default(cuid())
  publisherId     String
  grade           Int
  examName        String
  published       Boolean  @default(true)
  showInEvaluation Boolean @default(false)
  opticalKey OpticalKey?
  publishedAt     DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  publisher Publisher       @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  createdBy User            @relation("PublishedAnswerKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  files     AnswerKeyFile[]
  scheduleEntries ExamScheduleEntry[]

  @@index([published, createdAt])
  @@index([published, publishedAt])
  @@index([publisherId, grade])
}

model ExamScheduleEntry {
  id          String @id @default(cuid())
  publisherId String
  level       String
  sequence    Int
  examDate    DateTime @db.Date
  scope       String @db.Text
  answerKeyId String?
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  importId String?
  importBaseline DateTime?
  series String?
  sourcePublisher String?
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  answerKey PublishedAnswerKey? @relation(fields: [answerKeyId], references: [id], onDelete: SetNull)
  @@unique([publisherId, level, sequence, examDate])
  @@index([published, level, examDate])
  @@index([answerKeyId])
  @@index([importId])
}

model AnswerKeyFile {
  generated Boolean @default(false)
  id               String                @id @default(cuid())
  answerKeyId      String
  category         AnswerKeyFileCategory
  originalFileName String
  storedFileName   String
  mimeType         String
  size             Int
  storagePath      String
  createdAt        DateTime              @default(now())

  publishedAnswerKey PublishedAnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)

  @@index([answerKeyId, category])
}

model ScanRecord {
  id            String   @id @default(cuid())
  uploadBatchId String
  studentNumber String
  studentName   String?
  classroom     String?
  answers       Json
  rawLineNumber Int?
  createdAt     DateTime @default(now())

  uploadBatch UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)

  @@unique([uploadBatchId, studentNumber])
  @@index([studentNumber])
  @@index([classroom])
}

model ContactMessage {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String    @db.Text
  userId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  action      String
  targetType  String?
  targetId    String?
  summary     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model ScheduleImport {
  id String @id @default(cuid())
  actorId String
  createdAt DateTime @default(now())
  total Int
  saved Int @default(0)
  invalid Int @default(0)
  duplicates Int @default(0)
  status String @default("processing")
}
model PublisherAlias {
  id String @id @default(cuid())
  source String @unique
  publisherId String
  series String?
  updatedAt DateTime @updatedAt
}

model FmtShare {
  id String @id @default(cuid())
  tokenHash String @unique
  templateId String?
  fileRefs Json?
  createdById String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  template OpticalTemplate? @relation(fields:[templateId],references:[id],onDelete:Cascade)
  @@index([createdById,createdAt])
  @@index([expiresAt])
}
