{
  "name": "optik-okuma-platformu",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "test": "node --import tsx tests/run.ts",
    "dev:api": "npm run dev -w @optik/api",
    "dev:web": "npm run dev -w @optik/web",
    "build": "npm run db:generate && npm run build -w @optik/api && npm run build -w @optik/web",
    "db:generate": "npm run db:generate -w @optik/api",
    "db:migrate": "npm run db:migrate -w @optik/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @optik/api",
    "db:seed": "npm run db:seed -w @optik/api",
    "test:report": "node tests/build-test-report.cjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "version": "1.2.1-rc.1"
}
