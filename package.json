{
  "name": "optik-okuma-platformu",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "test": "node --max-old-space-size=512 --import tsx tests/run.ts",
    "dev:api": "npm run dev -w @optik/api",
    "dev:web": "npm run dev -w @optik/web",
    "build": "npm run db:generate && npm run build -w @optik/api && npm run build -w @optik/web",
    "db:generate": "npm run db:generate -w @optik/api",
    "db:migrate": "npm run db:migrate -w @optik/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @optik/api",
    "db:seed": "npm run db:seed -w @optik/api",
    "test:report": "node tests/build-test-report.cjs",
    "check:static": "node scripts/static-assets-preflight.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "test:v145": "node --import tsx --test tests/study-plan.test.ts && node --test tests/quick-deploy.test.cjs tests/verify-release.test.cjs",
    "test:v146": "node --import tsx tests/e2e/v146-http.cjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "version": "1.4.8",
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}
