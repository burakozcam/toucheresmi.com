DATABASE_URL="postgresql://postgres:postgres@localhost:5432/optik_okuma?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@kurumsalsinav.com"
CONTACT_EMAIL="destek@kurumsalsinav.com"

# Optional stable key for encrypted TXT archive (32+ characters). Falls back to JWT_SECRET.
# Keep the same key when moving/restoring the private storage directory.
TXT_STORAGE_KEY=

# Development: false. Production must have exactly one provider enabled.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact browser hostname, without protocol or port.
TURNSTILE_HOSTNAME=

# Google reCAPTCHA v2/v3 (v1.2.8). Production: RECAPTCHA_ENABLED=true.
# Separate test/production keys. Hostname defaults to WEB_ORIGIN hostname.
RECAPTCHA_ENABLED=false
# Optional API fallback public key; normally supplied to Web below.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=

# v1.2.8 — shared root .env is also loaded by the Web command wrapper.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# API: RECAPTCHA_SECRET_KEY above; Web: public v3 site key (never the secret).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
# Development/test must use localhost DB unless a separate remote test DB is explicitly allowed.
ALLOW_REMOTE_DATABASE=false
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE=10485760
# Migration operators may use this direct URL; do not point test commands at production.
DIRECT_URL=
# Optional Google infrastructure. Empty means unconfigured, not connected.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_ID=
# Enable only after disabling Enhanced Measurement and auditing account-side tags.
NEXT_PUBLIC_GA4_APPROVED=false
# GTM loads only with explicit approval AND analytics consent.
NEXT_PUBLIC_GTM_ID=

# v1.2.8: v3 stays the default. v2 requires a NEW Checkbox key pair.
RECAPTCHA_VERSION=v3
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
# Enable a GTM container only after an audit; uses the same analytics consent.
NEXT_PUBLIC_GTM_APPROVED=false
