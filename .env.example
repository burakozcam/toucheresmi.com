DATABASE_URL="postgresql://postgres:postgres@localhost:5432/optik_okuma?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@kurumsalsinav.com"
CONTACT_EMAIL="destek@kurumsalsinav.com"

# Optional stable key for encrypted TXT archive (32+ characters). Falls back to JWT_SECRET.
# Keep the same key when moving/restoring the private storage directory.
TXT_STORAGE_KEY=

# Optional human verification. Keep disabled until BOTH apps are configured/tested.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact browser hostname, without protocol or port.
TURNSTILE_HOSTNAME=

# Google reCAPTCHA v2 checkbox (preferred provider for v1.2.0).
# Enable exactly one provider. Test and production must use separate keys.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=
